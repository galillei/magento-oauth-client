{
    "name": "galillei/magento-oauth-client",
    "description": "Magento 2 REST API client with OAuth 1.0a (HMAC-SHA256) request signing and a cURL transport",
    "type": "library",
    "license": "MIT",
    "keywords": ["magento", "magento2", "oauth", "oauth1", "hmac-sha256", "rest", "api-client"],
    "authors": [
        {
            "name": "Vinduesgrossisten"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Skanva\\MagentoOAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Skanva\\MagentoOAuth\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=-1",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "code-quality": [
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
